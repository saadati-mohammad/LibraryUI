    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "~6.0.3",
