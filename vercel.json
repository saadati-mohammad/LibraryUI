{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://librarybk.onrender.com/api/:path*"
    },
    {
      "source": "/ws-chat/:path*",
      "destination": "https://librarybk.onrender.com/ws-chat/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
